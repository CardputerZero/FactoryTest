#!/bin/sh
set -e

PRODUCT_GROUP="@APP_PRODUCT_GROUP@"

if [ "$1" = "configure" ]; then
    if ! getent group "$PRODUCT_GROUP" >/dev/null 2>&1; then
        if ! groupadd --system "$PRODUCT_GROUP"; then
            echo "Warning: failed to create product group $PRODUCT_GROUP; group-based permissions may be unavailable" >&2
        fi
    fi

    # Runtime account membership belongs to image provisioning or first-boot setup.
    # Package installation may run in a chroot with an unrelated SUDO_USER.

    # Only product-mode images use the packaged systemd services. Desktop/app
    # mode must remain launch-on-demand and must not alter the host's service
    # state when the package is installed.
    if [ "@FACTORY_TEST_PRODUCT_MODE@" = "ON" ]; then
        # Make newly installed systemd and DRM udev units available immediately.
        # These commands are intentionally best-effort because package installation
        # may run in a chroot or before either daemon is active.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            # Enable the HDMI precheck service at boot. The unit's [Install] section
            # (WantedBy=multi-user.target) makes this create the
            # /etc/systemd/system/multi-user.target.wants/factory_precheck.service symlink.
            systemctl enable factory_precheck.service >/dev/null 2>&1 || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload >/dev/null 2>&1 || true
        fi
    fi

fi

exit 0
